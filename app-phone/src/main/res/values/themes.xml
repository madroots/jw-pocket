<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="pocket_background">#FF0B0C10</color>
    <color name="pocket_accent">#FFFF3D5A</color>

    <style name="Theme.JwPocket" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pocket_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/pocket_accent</item>
    </style>

    <!-- Launch: the system splash (icon on the suit color), then MainActivity plays the pop-out animation. -->
    <style name="Theme.JwPocket.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.JwPocket</item>
    </style>
</resources>
