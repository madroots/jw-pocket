<?xml version="1.0" encoding="utf-8"?>
<!--
  The TV video picture. A TextureView draws inside the app's own window, so the
  picture shows on every TV; with the default SurfaceView some TVs played only
  the sound and subtitles, the picture hidden behind the app's layers.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:shutter_background_color="@android:color/black"
    app:show_buffering="never" />
